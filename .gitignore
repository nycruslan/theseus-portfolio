# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code
.claude/settings.local.json

# Screenshots are evidence for a report, not repository content: they go in the agent's
# scratchpad or here, never in git (49 PNGs, 3.8 MB, after two sprints). History keeps the old ones.
.crew/screenshots/
.crew/sprint/**/shots/
.crew/sprint/**/*.png
.crew/sprint/**/*.jpg
.crew/sprint/**/*.jpeg
.crew/sprint/**/*.webp

# parallel agents work in their own worktrees
.claude/worktrees/

# playwright
/test-results/
/playwright-report/
